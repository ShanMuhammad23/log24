EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# Google Sign-In (required for store builds — also set these in EAS → Environment → production)
# Web client ID from Google Cloud Console (OAuth client type: Web application)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
# iOS OAuth client ID (OAuth client type: iOS, bundle id = com.pilotshalasorganization.log24)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789-yyyy.apps.googleusercontent.com
# Reversed iOS client ID (prefix com.googleusercontent.apps.)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.123456789-yyyy
